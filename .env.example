# Aldeia Primatus — prod env (gerado 2026-06-01)

# Server identity
SERVER_NAME=Aldeia Primatus
SERVER_MOTD=Bem-vindo a Aldeia da tribo Primatus
SERVER_ICON=

# Mode
DEBUG_MODE=false
NODE_ENV=development

# Map de inicio
START_ROOM_URL=/_/global/maps.aldeia.primatus.com.br/aldeia/aldeia-primatus.tmj

# Sem video p2p (TURN/STUN opcional)
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USER=
TURN_PASSWORD=
TURN_STATIC_AUTH_SECRET=

# Jitsi (default test instance)
JITSI_URL=meet.jit.si
JITSI_PRIVATE_MODE=false
JITSI_ISS=
SECRET_JITSI_KEY=

# BigBlueButton (test, ok pra dev)
BBB_URL=
BBB_SECRET=

# Sem admin externo
ADMIN_API_URL=
ADMIN_API_TOKEN=__SET_VIA_EASYPANEL__

# Secrets
SECRET_KEY=__SET_VIA_EASYPANEL__
ROOM_API_SECRET_KEY=
PROMETHEUS_AUTHORIZATION_TOKEN=

# UX defaults
DISABLE_NOTIFICATIONS=true
SKIP_RENDER_OPTIMIZATIONS=false
SKIP_CAMERA_PAGE=true
MAX_PER_GROUP=100
GROUP_RADIUS=
MAX_USERNAME_LENGTH=10
MINIMUM_DISTANCE=
DISABLE_ANONYMOUS=
PROVIDE_DEFAULT_WOKA_NAME=no
PROVIDE_DEFAULT_WOKA_TEXTURE=no
DEFAULT_WOKA_NAME=
DEFAULT_WOKA_TEXTURE=
BYPASS_PWA=false

# OpenID off (sem login)
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_CLIENT_ISSUER=
OPENID_PROFILE_SCREEN_PROVIDER=
OPENID_PROMPT=
OPENID_USERNAME_CLAIM=
OPENID_LOCALE_CLAIM=
OPENID_LOGOUT_REDIRECT_URL=

# Chat (off pra simplificar - sem Matrix)
ENABLE_CHAT=false
ENABLE_CHAT_UPLOAD=false
ENABLE_REPORT_ISSUES_MENU=false

# Integrations (off)
KLAXOON_ENABLED=false
KLAXOON_CLIENT_ID=
YOUTUBE_ENABLED=false
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DOCS_ENABLED=false
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SLIDES_ENABLED=false
ERASER_ENABLED=false
EXCALIDRAW_ENABLED=false
EXCALIDRAW_DOMAINS=
EMBEDDED_DOMAINS_WHITELIST=
CARDS_ENABLED=false
TLDRAW_ENABLED=false
EMBEDLY_KEY=
GOOGLE_DRIVE_PICKER_CLIENT_ID=
GOOGLE_DRIVE_PICKER_APP_ID=

# Matrix (off, mas keep config to avoid undefined errors)
MATRIX_ADMIN_USER=admin
MATRIX_ADMIN_PASSWORD=disabled
MATRIX_DOMAIN=
MATRIX_API_URI=
MATRIX_PUBLIC_URI=

# Map editor (on, padrão)
ENABLE_MAP_EDITOR=true

# Whitelist (vazio = libera tudo)
WHITELISTED_RESOURCE_URLS=
